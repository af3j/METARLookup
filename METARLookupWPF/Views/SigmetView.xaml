<UserControl x:Class="METARLookupWPF.Views.SigmetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:METARLookupWPF.Converters"
             xmlns:models="clr-namespace:METARLookupWPF.Models">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <TextBlock Text="No active SIGMETs or AIRMETs."
                   Visibility="{Binding HasSigmets, Converter={StaticResource InvBoolVis}}"
                   FontSize="14" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ScrollViewer Visibility="{Binding HasSigmets, Converter={StaticResource BoolVis}}">
            <ItemsControl ItemsSource="{Binding Sigmets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Sigmet}">
                        <Border CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="4" Padding="8,4" VerticalAlignment="Top"
                                        Background="#CC3333">
                                    <TextBlock Text="{Binding AirSigmetType}" Foreground="White"
                                               FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                                        <Run Text="{Binding Hazard}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Severity}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RawText}" FontFamily="Consolas" FontSize="10"
                                               TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ValidFrom, StringFormat='From: {0:HH:mm}Z'}"
                                               FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding ValidTo, StringFormat='To: {0:HH:mm}Z'}"
                                               FontSize="11" Opacity="0.7"/>
                                    <TextBlock FontSize="11" Opacity="0.7" Margin="0,4,0,0">
                                        <Run Text="{Binding MinAltFtMsl}"/>
                                        <Run Text="–"/>
                                        <Run Text="{Binding MaxAltFtMsl}"/>
                                        <Run Text=" ft MSL"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
