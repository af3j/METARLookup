<Window x:Class="METARLookupWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:METARLookupWPF.Converters"
        xmlns:views="clr-namespace:METARLookupWPF.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="METAR Lookup" Height="760" Width="1100"
        MinWidth="900" MinHeight="600">

    <Window.Resources>
        <!-- CatBrush: converts a flight-category string (VFR/MVFR/IFR/LIFR) to a foreground Brush -->
        <conv:FlightCategoryBrushConverter x:Key="CatBrush"/>
        <!-- CatBg: converts a flight-category string to a background Brush for the favourite chip -->
        <conv:FlightCategoryBackgroundConverter x:Key="CatBg"/>
        <!-- BoolVis: true → Visible, false → Collapsed -->
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <!-- InvBoolVis: true → Collapsed, false → Visible (used for "no data" placeholders) -->
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <!-- SigmetBadge: converts SIGMET count to Visibility — Collapsed when count is 0 -->
        <conv:SigmetBadgeConverter x:Key="SigmetBadge"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Search Bar -->
        <Border Grid.Row="0" Padding="16,10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="✈" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="METAR Lookup" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Box -->
                <ui:AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                    PlaceholderText="ICAO code (e.g. KSEA)"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Lookup" Margin="8,0,0,0"
                        Click="LookupButton_Click"
                        Style="{DynamicResource AccentButtonStyle}"
                        VerticalAlignment="Center"/>

                <!-- Favorites Strip: each chip is coloured by the flight category at save-time -->
                <ItemsControl Grid.Column="3" ItemsSource="{Binding Favorites}" Margin="16,0,0,0"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Each chip binds its background to the saved FlightCategory via CatBg -->
                            <Border CornerRadius="4" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                                    Background="{Binding FlightCategory, Converter={StaticResource CatBg}}">
                                <Border.InputBindings>
                                    <!-- RelativeSource walk-up is needed because DataContext here is FavoriteStation,
                                         not MainViewModel — the command lives on the window's DataContext -->
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icao}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Width="8" Height="8" CornerRadius="4" Margin="4,0,4,0" VerticalAlignment="Center"
                                            Background="{Binding FlightCategory, Converter={StaticResource CatBrush}}"/>
                                    <Button Content="×" FontSize="11" Padding="2,0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" Foreground="White" Opacity="0.7"
                                            Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Controls -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="☆ Save" Command="{Binding AddFavoriteCommand}"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button Content="⚡ API Status" Click="ApiStatus_Click"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="ThemeSwitch" Content="🌙 Dark" VerticalAlignment="Center"
                                 Checked="ThemeSwitch_Toggled" Unchecked="ThemeSwitch_Toggled"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error Banner: overlays Row 1; visible only when HasError is true -->
        <Border Grid.Row="1" Background="#CC3333" Padding="12,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="White" FontSize="13"/>
        </Border>

        <!-- Busy Indicator: shares Row 1 with the error banner; visible only during async fetches -->
        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="12,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsActive="True" Width="18" Height="18" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Tab Content -->
        <TabControl Grid.Row="2" x:Name="MainTabs"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    SelectionChanged="MainTabs_SelectionChanged">

            <TabItem Header="METAR">
                <views:MetarView DataContext="{Binding MetarVm}"/>
            </TabItem>

            <TabItem Header="TAF">
                <views:TafView DataContext="{Binding TafVm}"/>
            </TabItem>

            <TabItem Header="Map">
                <views:MapView x:Name="MapViewControl"/>
            </TabItem>

            <TabItem Header="Airport Charts">
                <views:ChartsView DataContext="{Binding ChartsVm}"/>
            </TabItem>

            <!-- SIGMETs tab: custom header with a red count badge when advisories are active.
                 The badge uses SigmetBadgeConverter which returns Collapsed when count == 0. -->
            <TabItem>
                <TabItem.Header>
                    <Grid>
                        <TextBlock Text="SIGMETs"/>
                        <Border CornerRadius="8" Padding="4,1" Margin="48,-6,0,0"
                                Background="#CC3333" VerticalAlignment="Top" HorizontalAlignment="Left"
                                Visibility="{Binding SigmetVm.SigmetCount, Converter={StaticResource SigmetBadge}}">
                            <TextBlock Text="{Binding SigmetVm.SigmetCount}"
                                       Foreground="White" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </TabItem.Header>
                <views:SigmetView DataContext="{Binding SigmetVm}"/>
            </TabItem>

            <TabItem Header="Calculators">
                <views:CalculatorsView DataContext="{Binding CalculatorsVm}"/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="3" Padding="16,6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Text="METARLookup v2.0 • Data: aviationweather.gov"
                           HorizontalAlignment="Right" FontSize="11" Opacity="0.4" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
