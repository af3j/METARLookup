<Window x:Class="METARLookupWPF.Views.ApiStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:METARLookupWPF.Converters"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="API Status" Width="580" Height="340"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0" ItemsSource="{Binding Endpoints}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            Padding="4,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding Url}" FontSize="10" Opacity="0.45"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <ui:ProgressRing IsActive="True" Width="14" Height="14" Margin="0,0,6,0"
                                                 Visibility="{Binding IsChecking, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                                           FontSize="12" MinWidth="110" TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                    <Setter Property="Foreground" Value="#22BB45"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOk}" Value="False">
                                                    <Setter Property="Foreground" Value="#EE4433"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="↻ Refresh" Click="Refresh_Click" Margin="0,0,8,0"/>
            <Button Content="Close" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
